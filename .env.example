# GEMINI_API_KEY: Required for Gemini AI API calls (if enabled).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Server configuration
PORT="3000"
NODE_ENV="development"

# Security & Authentication
AUTH_SECRET="roommitra_super_secure_jwt_secret_change_in_production"
SESSION_EXPIRY_DAYS="7"

# Database Configuration (PostgreSQL / Relational / In-memory persistence)
DATABASE_URL="postgresql://postgres:password@localhost:5432/roommitra"

# Storage Configuration
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE_MB="5"

# Optional External Integrations
PAYMENT_GATEWAY_KEY="rzp_test_samplekey"
PAYMENT_GATEWAY_SECRET="rzp_secret_samplesecret"
EMAIL_API_KEY="sample_resend_api_key"

