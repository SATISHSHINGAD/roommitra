# Google Gemini (optional; only needed for AI features)
GEMINI_API_KEY=

# Public application URL
APP_URL=https://roommitra.in

# Server
PORT=3000
NODE_ENV=production

# Database (Neon PostgreSQL)
DATABASE_URL=

# Security & Authentication
AUTH_SECRET=
SESSION_EXPIRY_DAYS=7

# Demo data/login (development only)
DEMO_MODE=false
VITE_DEMO_MODE=false

# One-time initial Super Admin bootstrap.
# Set both values before the first production start if you want the
# application to create the first SUPER_ADMIN account automatically.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_NAME=RoomMitra Administrator
INITIAL_ADMIN_PHONE=
INITIAL_ADMIN_CITY=Ahmedabad

# Local-development uploads only. Production should use durable object storage.
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=5

# Optional external integrations
PAYMENT_GATEWAY_KEY=
PAYMENT_GATEWAY_SECRET=
EMAIL_API_KEY=
